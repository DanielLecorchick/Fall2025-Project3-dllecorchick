@model Fall2025_Project3_dllecorchick.Models.ActorDetailsModel

@{
    ViewData["Title"] = @Model.Actor.Name;
}

<h1 class="page-title">@Model.Actor.Name</h1>

<div class="glass-card p-4 mb-4">
    <h4 class="section-title">Actor Info</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Actor.Name</dd>

        <dt class="col-sm-2">Gender</dt>
        <dd class="col-sm-10">@Model.Actor.Gender</dd>

        <dt class="col-sm-2">Age</dt>
        <dd class="col-sm-10">@Model.Actor.Age</dd>

        <dt class="col-sm-2">IMDB</dt>
        <dd class="col-sm-10">
            <a href="@Model.Actor.IMDBLink" target="_blank">@Model.Actor.IMDBLink</a>
        </dd>

        <dt class="col-sm-2">Photo</dt>
        <dd class="col-sm-10">
            @if (Model.Actor.Photo != null)
            {
                <img src="@Url.Action("Photo", "Actors", new { id = Model.Actor.Id })"
                     alt="Actor Photo"
                     class="glass-image"
                     style="max-width:180px; border-radius:12px;" />
            }
            else
            {
                <span class="text-muted">No photo available.</span>
            }
        </dd>
    </dl>
</div>

@if (Model.Actor.ActorMovies != null && Model.Actor.ActorMovies.Any())
{
    <h3 class="section-title mt-4">Movies Featuring @Model.Actor.Name</h3>

    <div class="glass-card p-4 mb-4">
        <ul>
            @foreach (var am in Model.Actor.ActorMovies)
            {
                <li>@am.Movie?.Title</li>
            }
        </ul>
    </div>
}
else
{
    <p><em>No movies listed for this actor.</em></p>
}

<h3 class="section-title mt-4">AI-Generated Tweets About @Model.Actor.Name</h3>

@if (Model.Posts != null && Model.Posts.Any())
{
    <p>
        <strong>Average Sentiment:</strong>
        <span class="badge bg-primary">@Model.AverageSentiment?.ToString("0.00")</span>
    </p>

    <table class="table mt-3">
        <thead>
            <tr>
                <th>Tweet</th>
                <th>Sentiment</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (tweet, sentiment) in Model.Posts)
            {
                <tr>
                    <td>@tweet</td>
                    <td>@sentiment.ToString("0.000")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p><em>AI tweets are loading or unavailable.</em></p>
}

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Actor.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
