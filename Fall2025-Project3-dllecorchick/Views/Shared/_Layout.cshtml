<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fall2025_Project3_dllecorchick</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="nav-left">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Movie and Actor AI 
                </a>

                <a class="nav-link" asp-controller="Movies" asp-action="Index">Movies</a>
                <a class="nav-link" asp-controller="Actors" asp-action="Index">Actors</a>
                <a class="nav-link" asp-controller="ActorMovies" asp-action="Index">Actor-Movie Relationships</a>
            </div>

            <div class="nav-right">
                <a class="github-link" href="https://github.com/DanielLecorchick/Fall2025-Project3-dllecorchick" target="_blank">
                    GitHub
                </a>
                <partial name="_LoginPartial"/>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Fall2025_Project3_dllecorchick - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
